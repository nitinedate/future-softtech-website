# Copy this file to .env and adjust the values.

# Port the API (and, in production, the built website) listens on.
PORT=4000

# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# For a hosted database that needs SSL, add ?sslmode=require to the end.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/future_softtech

# "production" makes the session cookie HTTPS-only. Keep "development" locally.
NODE_ENV=development

# Set to true when the app runs behind a reverse proxy such as Nginx,
# Render or Railway, so rate limiting and logging see the real client IP.
TRUST_PROXY=false
