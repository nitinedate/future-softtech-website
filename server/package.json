{
  "name": "future-softtech-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express + PostgreSQL API for the Future SoftTech client login",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:init": "node scripts/init-db.js",
    "user:create": "node scripts/create-user.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "pg": "8.16.0"
  }
}
